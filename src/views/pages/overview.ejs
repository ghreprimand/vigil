<script id="__dashboard-cfg" type="application/json"><%- JSON.stringify({ cards: dashboardConfig.cards, meta: cardMeta }) %></script>

<%/* -- Arrange Mode Toolbar (hidden by default) ----------------------------- */%>
<div id="arrange-toolbar" style="display:none;position:sticky;top:72px;z-index:50;margin-bottom:0.5rem;">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:0.5rem 1rem;background:var(--accent);border-radius:var(--radius-md);color:#000;">
    <span style="font-weight:600;font-size:0.85rem;">Arrange Mode - drag cards to reorder</span>
    <div style="display:flex;gap:0.5rem;">
      <button id="arrange-cancel" class="btn btn-sm" style="font-size:0.78rem;background:rgba(0,0,0,0.15);color:#000;border:1px solid rgba(0,0,0,0.2);">Cancel</button>
      <button id="arrange-save" class="btn btn-sm" style="font-size:0.78rem;background:#000;color:var(--accent);font-weight:600;">Save Order</button>
    </div>
  </div>
</div>

<div id="overview-content"
     hx-get="/partials/overview-content"
     hx-trigger="every 60s">
  <%- include('../partials/overview-content.ejs') %>
</div>

<%/* -- Configure Layout Modal ----------------------------------------------- */%>
<dialog id="dashboard-config-dialog" style="background:var(--bg-secondary);color:var(--text-primary);border:1px solid var(--border-primary);border-radius:var(--radius-lg);max-width:560px;width:90vw;padding:0;max-height:85vh;">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:0.85rem 1.1rem;border-bottom:1px solid var(--border-secondary);">
    <h3 style="margin:0;font-size:0.95rem;font-weight:600;">Configure Cards</h3>
    <button id="cfg-close-x" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:1.1rem;padding:0.2rem;">&times;</button>
  </div>
  <div style="padding:0.75rem 1.1rem;max-height:60vh;overflow-y:auto;">
    <p class="text-muted text-sm" style="margin-bottom:0.75rem;">Toggle card visibility, width, and item counts.</p>
    <div id="config-card-list" style="display:flex;flex-direction:column;gap:2px;"></div>
  </div>
  <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1.1rem;border-top:1px solid var(--border-secondary);gap:0.5rem;">
    <button id="cfg-reset" class="btn btn-sm" style="font-size:0.78rem;color:var(--text-muted);">Reset to Defaults</button>
    <div style="display:flex;gap:0.5rem;">
      <button id="cfg-cancel" class="btn btn-sm" style="font-size:0.78rem;">Cancel</button>
      <button id="cfg-save" class="btn btn-sm" style="font-size:0.78rem;background:var(--accent);color:#000;font-weight:600;">Save</button>
    </div>
  </div>
</dialog>

<script src="/public/vendor/echarts/echarts.min.js"></script>
<script src="/public/vendor/sortable/Sortable.min.js"></script>
<script>
(function() {
  var raw = JSON.parse(document.getElementById('__dashboard-cfg').textContent);
  var cards = raw.cards.slice().sort(function(a, b) { return a.order - b.order; });
  var meta = raw.meta;
  var dialog = document.getElementById('dashboard-config-dialog');
  var list = document.getElementById('config-card-list');

  // -- Configure Modal (visibility, width, item counts) --------------------
  function buildList() {
    list.innerHTML = '';
    cards.forEach(function(card) {
      var m = meta[card.id] || { label: card.id, hasItemCount: false, defaultWidth: 'full', description: '' };
      var row = document.createElement('div');
      row.setAttribute('data-card-id', card.id);
      row.style.cssText = 'display:flex;align-items:center;gap:0.5rem;padding:0.45rem 0.6rem;background:var(--bg-tertiary);border-radius:6px;user-select:none;' + (!card.visible ? 'opacity:0.5;' : '');

      // Visibility checkbox + label
      var label = document.createElement('label');
      label.style.cssText = 'display:flex;align-items:center;gap:0.4rem;flex-shrink:0;cursor:pointer;font-size:0.82rem;';
      var cb = document.createElement('input');
      cb.type = 'checkbox'; cb.checked = card.visible;
      cb.style.cssText = 'accent-color:var(--accent);cursor:pointer;';
      cb.addEventListener('change', function() { card.visible = this.checked; row.style.opacity = this.checked ? '1' : '0.5'; });
      var nameSpan = document.createElement('span');
      nameSpan.style.fontWeight = '500'; nameSpan.textContent = m.label;
      label.appendChild(cb); label.appendChild(nameSpan);

      // Width toggle
      var widthBtn = document.createElement('button');
      widthBtn.className = 'btn btn-sm';
      widthBtn.style.cssText = 'font-size:0.65rem;padding:0.1rem 0.35rem;flex-shrink:0;min-width:36px;text-align:center;';
      var curW = card.width || m.defaultWidth || 'full';
      widthBtn.textContent = curW === 'half' ? '1/2' : 'Full';
      widthBtn.title = 'Toggle half/full width';
      widthBtn.addEventListener('click', function() {
        curW = curW === 'half' ? 'full' : 'half';
        card.width = curW;
        this.textContent = curW === 'half' ? '1/2' : 'Full';
      });

      // Description
      var descSpan = document.createElement('span');
      descSpan.className = 'text-muted';
      descSpan.style.cssText = 'font-size:0.68rem;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right;';
      descSpan.textContent = m.description;

      row.appendChild(label);
      row.appendChild(widthBtn);

      // Max height input
      var hWrap = document.createElement('div');
      hWrap.style.cssText = 'display:flex;align-items:center;gap:0.2rem;flex-shrink:0;';
      var hLbl = document.createElement('span');
      hLbl.className = 'text-muted'; hLbl.style.cssText = 'font-size:0.68rem;'; hLbl.textContent = 'H:';
      var hInput = document.createElement('input');
      hInput.type = 'number'; hInput.min = '0'; hInput.max = '2000'; hInput.step = '10';
      hInput.value = card.maxHeight || 0;
      hInput.placeholder = 'auto';
      hInput.title = 'Max height in px (0 = auto)';
      hInput.style.cssText = 'width:50px;padding:0.15rem 0.25rem;font-size:0.72rem;background:var(--bg-input);color:var(--text-primary);border:1px solid var(--border-primary);border-radius:4px;text-align:center;';
      hInput.addEventListener('change', function() {
        var v = parseInt(this.value) || 0;
        card.maxHeight = v > 0 ? Math.min(2000, v) : 0;
        if (card.maxHeight === 0) { this.value = 0; delete card.maxHeight; }
      });
      hWrap.appendChild(hLbl); hWrap.appendChild(hInput);
      row.appendChild(hWrap);

      row.appendChild(descSpan);

      // Item count (if applicable)
      if (m.hasItemCount) {
        var icWrap = document.createElement('div');
        icWrap.style.cssText = 'display:flex;align-items:center;gap:0.3rem;flex-shrink:0;';
        var icLbl = document.createElement('span');
        icLbl.className = 'text-muted'; icLbl.style.cssText = 'font-size:0.72rem;'; icLbl.textContent = 'Items:';
        var icInput = document.createElement('input');
        icInput.type = 'number'; icInput.min = '1'; icInput.max = '50';
        icInput.value = card.itemCount || m.defaultItemCount || 5;
        icInput.style.cssText = 'width:44px;padding:0.15rem 0.3rem;font-size:0.78rem;background:var(--bg-input);color:var(--text-primary);border:1px solid var(--border-primary);border-radius:4px;text-align:center;';
        icInput.addEventListener('change', function() { card.itemCount = Math.max(1, Math.min(50, parseInt(this.value) || 5)); });
        icWrap.appendChild(icLbl); icWrap.appendChild(icInput);
        row.appendChild(icWrap);
      }
      list.appendChild(row);
    });
  }

  window.openDashboardConfig = function() {
    try { var fresh = JSON.parse(document.getElementById('__dashboard-cfg').textContent); cards = fresh.cards.slice().sort(function(a,b){return a.order-b.order;}); } catch(e) {}
    buildList(); dialog.showModal();
  };
  document.getElementById('cfg-close-x').addEventListener('click', function() { dialog.close(); });
  document.getElementById('cfg-cancel').addEventListener('click', function() { dialog.close(); });
  document.getElementById('cfg-save').addEventListener('click', function() {
    var btn = this; btn.textContent = 'Saving...'; btn.disabled = true;
    cards.forEach(function(c, i) { c.order = i; });
    fetch('/overview/config', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cards: cards }) })
      .then(function(res) { if (res.ok) { dialog.close(); window.location.reload(); } })
      .finally(function() { btn.textContent = 'Save'; btn.disabled = false; });
  });
  document.getElementById('cfg-reset').addEventListener('click', function() {
    var btn = this; btn.textContent = 'Resetting...'; btn.disabled = true;
    fetch('/overview/config/reset', { method: 'POST', redirect: 'follow' })
      .then(function(res) {
        // 204 = success, 302/200 = may have been redirected through auth
        dialog.close();
        window.location.reload();
      })
      .catch(function(err) {
        alert('Reset failed: ' + err.message);
        btn.textContent = 'Reset to Defaults'; btn.disabled = false;
      });
  });

  // -- Arrange Mode (drag cards on the live page) --------------------------
  var arrangeActive = false;
  var arrangeSortable = null;
  var arrangeSnapshot = null;

  window.enterArrangeMode = function() {
    if (arrangeActive) return;
    arrangeActive = true;
    var container = document.getElementById('overview-card-container');
    if (!container) return;

    // Snapshot current DOM order for cancel
    arrangeSnapshot = [];
    container.querySelectorAll('.ov-card-block').forEach(function(el) { arrangeSnapshot.push(el.getAttribute('data-card-id')); });

    // Pause HTMX auto-refresh
    var oc = document.getElementById('overview-content');
    if (oc) oc.removeAttribute('hx-trigger');

    document.getElementById('arrange-toolbar').style.display = 'block';
    document.body.classList.add('ov-arrange-active');

    if (typeof Sortable !== 'undefined') {
      arrangeSortable = Sortable.create(container, {
        handle: '.ov-arrange-handle',
        animation: 200,
        ghostClass: 'sortable-ghost',
        chosenClass: 'sortable-chosen',
      });
    }
  };

  function exitArrangeMode() {
    arrangeActive = false;
    document.getElementById('arrange-toolbar').style.display = 'none';
    document.body.classList.remove('ov-arrange-active');
    if (arrangeSortable) { arrangeSortable.destroy(); arrangeSortable = null; }
    var oc = document.getElementById('overview-content');
    if (oc) { oc.setAttribute('hx-trigger', 'every 60s'); htmx.process(oc); }
  }

  document.getElementById('arrange-cancel').addEventListener('click', function() {
    if (arrangeSnapshot) {
      var container = document.getElementById('overview-card-container');
      arrangeSnapshot.forEach(function(id) {
        var el = container.querySelector('[data-card-id="' + id + '"]');
        if (el) container.appendChild(el);
      });
    }
    exitArrangeMode();
  });

  document.getElementById('arrange-save').addEventListener('click', function() {
    var btn = this; btn.textContent = 'Saving...'; btn.disabled = true;
    var container = document.getElementById('overview-card-container');

    // Read new order + widths from DOM
    var domOrder = [];
    container.querySelectorAll('.ov-card-block').forEach(function(el) {
      domOrder.push({ id: el.getAttribute('data-card-id'), width: el.getAttribute('data-card-width') || 'full', maxHeight: parseInt(el.getAttribute('data-card-maxh')) || 0 });
    });

    // Merge with full config (including hidden cards)
    var fresh = JSON.parse(document.getElementById('__dashboard-cfg').textContent);
    var updated = fresh.cards.slice();
    var idToOrder = {};
    domOrder.forEach(function(item, i) { idToOrder[item.id] = { order: i, width: item.width, maxHeight: item.maxHeight }; });
    var maxVisible = domOrder.length;
    updated.forEach(function(c) {
      if (c.id in idToOrder) { c.order = idToOrder[c.id].order; c.width = idToOrder[c.id].width; }
      else { c.order = maxVisible + (c.order || 0); }
    });
    updated.sort(function(a, b) { return a.order - b.order; });
    updated.forEach(function(c, i) { c.order = i; });

    fetch('/overview/config', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cards: updated }) })
      .then(function(res) { if (res.ok) { exitArrangeMode(); window.location.reload(); } })
      .finally(function() { btn.textContent = 'Save Order'; btn.disabled = false; });
  });
})();
</script>

<style>
  /* -- Grid layout: 2 columns, side-by-side cards stretch to same height -- */
  .ov-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .ov-full { grid-column: 1 / -1; }
  .ov-half { grid-column: span 1; }
  .ov-card-block {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .ov-card-block > .card { flex: 1; }
  /* Max-height: clamp the card to a set height, clip content inside -
     the card header/border/radius are always visible. */
  .ov-card-block.ov-clamped > .card {
    max-height: var(--card-max-h, none);
    overflow: hidden;
  }
  @media (max-width: 900px) {
    .ov-grid { grid-template-columns: 1fr; }
    .ov-half { grid-column: span 1; }
  }

  /* -- Arrange mode -- */
  .ov-arrange-handle {
    display: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(255, 140, 0, 0.08);
    border: 1px dashed rgba(255, 140, 0, 0.3);
    border-radius: 6px 6px 0 0;
    cursor: grab;
    user-select: none;
  }
  .ov-arrange-handle .ov-grip { font-size: 1rem; line-height: 1; opacity: 0.6; }
  .ov-arrange-active .ov-arrange-handle { display: flex; }
  .ov-arrange-active .ov-card-block {
    border: 1px dashed rgba(255, 140, 0, 0.25);
    border-radius: var(--radius-md);
    transition: box-shadow 0.15s;
  }
  .ov-arrange-active .ov-card-block:hover {
    border-color: rgba(255, 140, 0, 0.5);
    box-shadow: 0 0 12px rgba(255, 140, 0, 0.1);
  }
  .sortable-ghost { opacity: 0.3; background: var(--accent-glow) !important; border-radius: var(--radius-md); }
  .sortable-chosen { box-shadow: 0 4px 20px rgba(255, 140, 0, 0.25); }
  dialog::backdrop { background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(2px); }
</style>
