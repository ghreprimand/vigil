<div class="breadcrumbs">
  <a href="/kb">Knowledge Base</a>
  <span class="sep">/</span>
  <span><%= doc.title %></span>
</div>

<div class="page-header" style="margin-bottom:0.5rem;">
  <h1><%= doc.title %></h1>
  <div style="margin-left:auto;display:flex;gap:0.5rem;">
    <a href="/kb/<%= doc.slug %>/edit" class="btn btn-sm" data-help="kb-edit">Edit</a>
    <button type="button" class="btn btn-sm btn-danger" data-help="kb-delete" onclick="document.getElementById('delete-modal').style.display='flex'">Delete</button>
  </div>
</div>

<%/* Delete confirmation modal */%>
<div id="delete-modal" data-help="kb-delete-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:100;align-items:center;justify-content:center;"
     onclick="if(event.target===this)this.style.display='none'">
  <div class="card" style="width:480px;max-width:90vw;">
    <div class="card-header">Delete Article</div>
    <div class="card-body">
      <p style="margin-bottom:0.75rem;">Are you sure you want to delete <strong><%= doc.title %></strong>?</p>
      <form method="POST" action="/kb/<%= doc.slug %>/delete">
        <% const advs = typeof linkedAdvisories !== 'undefined' ? linkedAdvisories : []; %>
        <% if (advs.length > 0) { %>
          <div style="margin-bottom:0.75rem;padding:0.6rem 0.75rem;background:var(--bg-secondary);border:1px solid var(--border-color);border-radius:var(--radius);">
            <label data-help="kb-delete-advisories-checkbox" style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
              <input type="checkbox" name="delete_advisories" value="1">
              <span>Also delete <strong><%= advs.length %></strong> linked advisor<%= advs.length === 1 ? 'y' : 'ies' %></span>
            </label>
            <ul style="margin:0.4rem 0 0 1.75rem;font-size:0.8rem;color:var(--text-muted);list-style:disc;">
              <% advs.forEach(function(a) { %>
                <li><%= a.title %> <span class="badge badge-advisory-<%= a.severity %>" style="font-size:0.65rem;"><%= a.severity %></span></li>
              <% }) %>
            </ul>
          </div>
        <% } %>
        <div style="display:flex;gap:0.5rem;justify-content:flex-end;">
          <button type="button" class="btn btn-sm" data-help="kb-delete-cancel" onclick="document.getElementById('delete-modal').style.display='none'">Cancel</button>
          <button type="submit" class="btn btn-sm btn-danger" data-help="kb-delete-confirm">Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

<% const docTags = doc.tags || []; %>
<% if (docTags.length > 0) { %>
  <div data-help="kb-tags" style="display:flex;gap:0.35rem;flex-wrap:wrap;margin-bottom:1rem;">
    <% docTags.forEach(function(t) { %>
      <a href="/kb?tag=<%= encodeURIComponent(t) %>" class="badge badge-info" data-help="kb-tag-badge" style="text-decoration:none;"><%= t %></a>
    <% }) %>
  </div>
<% } %>

<div class="grid-2" style="grid-template-columns: 1fr 280px;">
  <div class="card" data-help="kb-body">
    <div class="card-body md-body">
      <%- renderMarkdown(doc.body || '') %>
    </div>
  </div>

  <div>
    <% if (linkedPackages.length > 0) { %>
    <div class="card" data-help="kb-linked-packages">
      <div class="card-header">Linked Packages</div>
      <div class="card-body">
        <ul class="dep-list" style="flex-direction:column;">
          <% linkedPackages.forEach(function(pkg) { %>
            <li data-help="kb-linked-package-item"><a href="/packages/<%= encodeURIComponent(pkg.name) %>"><%= pkg.name %> <span class="text-muted mono" style="font-size:0.75rem;"><%= pkg.version %></span></a></li>
          <% }) %>
        </ul>
      </div>
    </div>
    <% } %>

    <% const viewAdvs = typeof linkedAdvisories !== 'undefined' ? linkedAdvisories : []; %>
    <% if (viewAdvs.length > 0) { %>
    <div class="card" data-help="kb-linked-advisories" style="margin-top:0.75rem;">
      <div class="card-header">Linked Advisories</div>
      <div class="card-body">
        <ul class="dep-list" style="flex-direction:column;">
          <% viewAdvs.forEach(function(a) { %>
            <li data-help="kb-linked-advisory-item">
              <a href="/advisories/<%= a.id %>"><%= a.title %></a>
              <span class="badge badge-advisory-<%= a.severity %>" style="font-size:0.65rem;margin-left:0.35rem;"><%= a.severity %></span>
              <% if (a.resolved_at || a.resolvedAt) { %><span class="badge badge-current" style="font-size:0.65rem;margin-left:0.25rem;">resolved</span><% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
    <% } %>

    <div class="card" style="margin-top:0.75rem;">
      <div class="card-body">
        <table class="info-table">
          <tr data-help="kb-slug"><td>Slug</td><td class="mono"><%= doc.slug %></td></tr>
          <tr data-help="kb-created"><td>Created</td><td><%= fmtDateTime(doc.created_at || doc.createdAt) %></td></tr>
          <tr data-help="kb-updated"><td>Updated</td><td><%= fmtDateTime(doc.updated_at || doc.updatedAt) %></td></tr>
        </table>
      </div>
    </div>
  </div>
</div>
