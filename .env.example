NODE_ENV=production
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Time zone for displayed dates (IANA name). Defaults to the server time zone.
#DISPLAY_TIMEZONE=UTC

# SQLite database file. Relative paths resolve against the app root; the
# directory is created automatically at startup. In Docker this lives on the
# mounted data volume (e.g. /app/data/vigil.db).
DATABASE_PATH=data/vigil.db

API_KEY_ID=vigil-push-1
API_KEY_SECRET=replace-with-random-shared-secret
HMAC_TIMESTAMP_WINDOW_MS=300000

SESSION_SECRET=replace-with-random-session-secret-at-least-32-bytes
COOKIE_SECURE=false

AUTH_MODE=password
AUTH_USERNAME=admin
# Generate with the command in docs/deployment.md "Required Settings".
# Leave unset for the Docker Compose quickstart: the compose file ships a
# default hash (admin / change-me). Do NOT paste an unquoted value containing
# `$` here - Docker Compose interpolates $VAR inside .env values and will
# silently mangle the hash.
#AUTH_PASSWORD_HASH=

OIDC_ISSUER=https://idp.example.com/application/o/vigil/
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_REDIRECT_URI=https://vigil.example.com/auth/callback

SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=vigil@example.com
ALERT_EMAIL=admin@example.com

GITHUB_TOKEN=
NVD_API_KEY=
